[gd_scene format=3 uid="uid://buxr44ik52hrw"]

[sub_resource type="GDScript" id="GDScript_buf6v"]
script/source = "extends StaticBody3D

@onready var mesh: MeshInstance3D = $MeshInstance3D
@onready var particulas: GPUParticles3D = $GPUParticles3D


func destruir():
	var efecto = particulas.duplicate()

	get_tree().current_scene.add_child(efecto)

	efecto.global_transform = particulas.global_transform
	efecto.emitting = true

	mesh.visible = false
	$CollisionShape3D.set_deferred(\"disabled\", true)

	queue_free()
"

